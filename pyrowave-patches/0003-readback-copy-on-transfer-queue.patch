 	if (!enc->encoder.init(&info->device->device, info->width, info->height, enc->chroma))
 	{
@@ -1148,6 +1185,36 @@ pyrowave_encoder_encode_gpu_synchronous_inner(pyrowave_encoder encoder,
 	// Performance issue since these memory types are mapped coherent on the GPU.
 	// A staging copy is just better. Could avoid it on iGPU, but iGPU isn't really supposed to be
 	// used as the encoder when streaming.
+	if (encoder->readback_on_transfer)
+	{
+		// ALVR: "encode total" is then the compute queue's part; the copy follows on the transfer
+		// queue, which waits for the compute submission with a semaphore. The buffers are shared
+		// between the queue families (concurrent sharing), so no ownership transfer is needed.
+		auto compute_end = cmd->write_timestamp(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
+		if (encoder->total_start)
+			device->register_time_interval("GPU", std::move(encoder->total_start), compute_end, "encode total");
+
+		Semaphore compute_done;
+		device->submit(cmd, nullptr, 1, &compute_done);
+		// The input image is only read by the compute submission, so it can go back now.
+		pyrowave_device_signal_semaphore(device, encoder->pyro_device->queue_type, release);
+
+		device->add_wait_semaphore(CommandBuffer::Type::AsyncTransfer, compute_done,
+		                           VK_PIPELINE_STAGE_2_COPY_BIT, true);
+		auto copy_cmd = device->request_command_buffer(CommandBuffer::Type::AsyncTransfer);
+		auto copy_start = copy_cmd->write_timestamp(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
+		copy_cmd->copy_buffer(*encoder->queued_meta, *queued_meta_gpu);
+		copy_cmd->copy_buffer(*encoder->queued_bitstream, *queued_bitstream_gpu);
+		auto copy_end = copy_cmd->write_timestamp(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
+		device->register_time_interval("GPU", copy_start, copy_end, "readback copy (transfer queue)");
+		copy_cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+		                  VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_HOST_READ_BIT);
+
+		encoder->queued_fence.reset();
+		device->submit(copy_cmd, &encoder->queued_fence);
+		return PYROWAVE_SUCCESS;
+	}
+
