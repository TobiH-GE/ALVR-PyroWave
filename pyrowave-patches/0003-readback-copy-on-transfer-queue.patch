+// ALVR: the readback copy of the bitstream (~4 MB at 4 bpp) took 0.6-0.7 ms of the encode's
+// ~1.0 ms on the compute queue, twice the time of all compute passes together. On a transfer
+// queue of its own (a DMA engine; pyrowave-patches/0003 also has Granite create one next to a
+// high priority compute queue) the compute queue is free once the passes are done, and the copy
+// engine does the copy. That needs a queue that really is separate, and timestamps on it: the
+// transfer queue family must have timestamp bits, and queries must be reset from the host
+// (vkCmdResetQueryPool is not available on transfer queues).
+static bool readback_on_transfer_queue(Device &device, CommandBuffer::Type compute_type)
+{
+#ifdef PYROWAVE_TEST_FORCE_TRANSFER_READBACK
+	// Only for testing this path on a device with a single queue (e.g. lavapipe): the transfer
+	// "queue" is then the compute queue, which the semaphore and the fence handle all the same.
+	(void)compute_type;
+	return device.get_device_features().vk12_features.hostQueryReset;
+#endif
+	const auto &info = device.get_queue_info();
+	const auto compute = device.get_physical_queue_type(compute_type);
+	if (info.queues[QUEUE_INDEX_TRANSFER] == VK_NULL_HANDLE ||
+	    info.queues[QUEUE_INDEX_TRANSFER] == info.queues[compute])
+		return false;
+	if (!device.get_device_features().vk12_features.hostQueryReset)
+		return false;
+
+	uint32_t count = 0;
+	vkGetPhysicalDeviceQueueFamilyProperties(device.get_physical_device(), &count, nullptr);
+	std::vector<VkQueueFamilyProperties> props(count);
+	vkGetPhysicalDeviceQueueFamilyProperties(device.get_physical_device(), &count, props.data());
+	const uint32_t family = info.family_indices[QUEUE_INDEX_TRANSFER];
+	return family < count && props[family].timestampValidBits != 0;
+}
